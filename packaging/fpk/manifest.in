appname               = fnmusic-ext
version               = @VERSION@
display_name          = fnMusic 音源扩展 · QQ 音乐版
desc                  = 飞牛音乐第三方音源扩展（QQ 音乐修改版，基于 javycoder/fnos_music_ext）：零侵入接管官方音乐入口，内置 QQ 音乐音源（手机 QQ 扫码登录/搜索/播放/歌词），并提供 musicdl 聚合、网易云、洛雪自定义源与内置管理页。
platform              = all
source                = thirdparty
maintainer            = javycoder
