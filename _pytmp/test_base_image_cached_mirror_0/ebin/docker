#!/bin/bash

printf 'docker %s\n' "$*" >> "${STUB_STATE_DIR}/docker.log"
sub="${1:-}"
case "$sub" in
  info) exit ${DOCKER_INFO_RC:-0} ;;
  image)
    # docker image inspect <ref>：$3=ref
    for r in ${DOCKER_LOCAL_REFS:-}; do
      [ "$3" = "$r" ] && exit 0
    done
    exit 1
    ;;
  pull)
    for r in ${DOCKER_PULL_OK_REFS:-}; do
      [ "$3" = "$r" ] && exit 0
    done
    exit 1
    ;;
esac
exit 0
